{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:monorepos"
  ],
  "schedule": ["before 6am on Monday"],
  "timezone": "America/Vancouver",
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "assignees": ["acockrell"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "platformAutomerge": true,
  "pinDigests": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "PHPUnit upgrades beyond 9.x blocked on WordPress test suite compatibility",
      "matchPackageNames": ["phpunit/phpunit"],
      "allowedVersions": "<10"
    },
    {
      "description": "polyfills v4+ requires PHPUnit 10+; keep in sync with phpunit/phpunit cap",
      "matchPackageNames": ["yoast/phpunit-polyfills"],
      "allowedVersions": "<4"
    },
    {
      "description": "@wordpress/* minor/major: manual review — minor bumps can carry breaking build-tool changes",
      "matchPackageNames": ["/^@wordpress\\//"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "@wordpress/* patch: auto-merge after CI",
      "matchPackageNames": ["/^@wordpress\\//"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Composer devDependency patch: auto-merge after CI",
      "matchManagers": ["composer"],
      "matchDepTypes": ["require-dev"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Composer devDependency minor/major: manual review",
      "matchManagers": ["composer"],
      "matchDepTypes": ["require-dev"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "GitHub Actions minor/patch/digest: auto-merge after CI",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "GitHub Actions major: manual review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "All major updates: manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    }
  ]
}
